label="MICA 2.0 | reproducible verification and remaining physical work";
isa [label="ISA + frozen 1.0 fixtures\nMICA2 compatibility mode"];
software [label="Release build / CTest\nassembly examples / matched RISC-V byte counts"];
rtl [label="Icarus SoC simulations\nVerilator retirement comparison\nrandom stalls / faults / reset / wake"];
formal [label="SBY component checks\nadder, SRAM, bounded FIFO\nnot a whole-core proof"];

digraph mica_trap {
  graph [label="MICA 1.0 / T machine trap path (implemented prototype)",labelloc=t,rankdir=LR,fontsize=18,fontname="DejaVu Sans",pad=.4];
  node [shape=box,style="rounded,filled",fillcolor="#f1f5fc",color="#416178",fontname="DejaVu Sans",fontsize=10];
  edge [color="#44617a",fontsize=9,fontname="DejaVu Sans"];
  src [label="External irq_i level\nSoC irq_i input\nArty ties low"];
  soft [label="Software ip.bit0\nCSRW ip"];
  gate [label="FETCH0 boundary\nstatus.IE & ie.bit0\n& (ip.bit0 | irq_i)\n& !handler-active",fillcolor="#e9f3dd"];
  entry [label="Save epc=PC\nCause=highbit | 1\nSave IE, clear IE\nHandler active=1"];
  ecall [label="ECALL EXECUTE\nSave epc=PC+2\nCause=11"];
  vector [label="PC = tvec\nNonzero, 2-byte aligned",fillcolor="#fff0d6"];
  handler [label="Handler instructions\nFirmware saves registers\nClear interrupt pending"];
  eret [label="ERET\nPC = epc\nRestore IE\nClear active"];
  src->gate;soft->gate;gate->entry [label="taken"];entry->vector;ecall->vector;vector->handler;handler->eret;eret->gate [label="resume fetch"];
}

digraph G {
graph [rankdir=LR,labelloc=t,fontname="DejaVu Sans",fontsize=16,pad=0.3];
node [shape=box,style="rounded,filled",fillcolor="#f1f5f9",color="#475569",fontname="DejaVu Sans",fontsize=11];
edge [fontname="DejaVu Sans",fontsize=9,color="#334155"];
label="MICA 2.0 | future multicore proposal; absent from current RTL";
current [label="Current: one multicycle core\nno MPU or multicore RTL"];
cores [label="Proposed pipelined cores + MPU"];
bus [label="Proposed shared-SRAM arbiter\nlatency, ordering and fairness contracts"];
atomic [label="Proposed reservations / coherency\nper-hart interrupt controller"];
current -> cores [label="future work"];
cores -> bus [label="proposed requests"];
bus -> atomic [label="requires verification"];
}

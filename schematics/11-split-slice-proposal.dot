digraph G {
graph [rankdir=LR,labelloc=t,fontname="DejaVu Sans",fontsize=16,pad=0.3];
node [shape=box,style="rounded,filled",fillcolor="#f1f5f9",color="#475569",fontname="DejaVu Sans",fontsize=11];
edge [fontname="DejaVu Sans",fontsize=9,color="#334155"];
label="MICA 2.0 | standalone segmented-adder experiment";
operands [label="64-bit add/sub operands\nenable + narrow mode"];
low [label="Low 33-bit adder\ncarry to upper slice"];
high [label="Upper 32-bit adder\nisolate operands/carry when narrow"];
result [label="Merge full-width result\nnarrow result sign extends low 32"];
scope [label="rtl/mica_add64.sv only\nmain core still uses conventional ALU\nformal equivalence and activity experiments"];
operands -> low [label="low operands"];
operands -> high [label="isolated high operands"];
low -> high [label="carry when wide"];
low -> result [label="low result"];
high -> result [label="high result"];
result -> scope [label="no whole-CPU power claim"];
}

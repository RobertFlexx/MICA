digraph G {
graph [rankdir=LR,labelloc=t,fontname="DejaVu Sans",fontsize=16,pad=0.3];
node [shape=box,style="rounded,filled",fillcolor="#f1f5f9",color="#475569",fontname="DejaVu Sans",fontsize=11];
edge [fontname="DejaVu Sans",fontsize=9,color="#334155"];
label="MICA 2.0 | implemented activity controls and unmeasured power";
sleep [label="WFI -> SLEEP\nno new instruction/data requests\nclock and enabled counters continue"];
fetch [label="One aligned-word reuse buffer\nfewer instruction transactions\ninvalidate on stores/redirects/fence.i"];
optional [label="Static parameter guards\nMUL / BITOPS / TRAP / PERF\nunused paths removed by synthesis"];
rails [label="No implemented power-rail domains\nno clock gating or DVFS\nwatts/joules require physical measurement"];
sleep -> rails [label="activity change only"];
fetch -> rails [label="memory traffic only"];
optional -> rails [label="mapped resource cost"];
}

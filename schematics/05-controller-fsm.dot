digraph G {
graph [rankdir=LR,labelloc=t,fontname="DejaVu Sans",fontsize=16,pad=0.3];
node [shape=box,style="rounded,filled",fillcolor="#f1f5f9",color="#475569",fontname="DejaVu Sans",fontsize=11];
edge [fontname="DejaVu Sans",fontsize=9,color="#334155"];
label="MICA 2.0 | transactional controller, MICA2=1";
START [label="START\ninterrupt/alignment boundary"];
LOOKUP [label="LOOKUP\n32-bit aligned fetch reuse"];
IREQ [label="IREQ\nhold instruction request"];
IWAIT [label="IWAIT\nawait instruction response"];
PARCEL [label="PARCEL\nselect lo/hi halfword"];
DECODE [label="DECODE\nvalidate, queue effects"];
DREQ [label="DREQ\nhold data request"];
DWAIT [label="DWAIT\nawait data response"];
COMMIT [label="COMMIT\nregister/CSR/PC writes, retirement"];
SLEEP [label="SLEEP\nno fetch/data requests or retirement"];
STOP [label="STOP\nterminal until reset"];
START -> LOOKUP [label="next instruction"];
LOOKUP -> PARCEL [label="reuse hit"];
LOOKUP -> IREQ [label="miss"];
IREQ -> IWAIT [label="i_req_ready"];
IWAIT -> PARCEL [label="successful response"];
PARCEL -> LOOKUP [label="second parcel needed"];
PARCEL -> DECODE [label="complete instruction"];
DECODE -> DREQ [label="memory"];
DECODE -> COMMIT [label="nonmemory"];
DREQ -> DWAIT [label="d_req_ready"];
DWAIT -> COMMIT [label="successful response"];
COMMIT -> START [label="continue"];
COMMIT -> SLEEP [label="q_wait: WFI"];
COMMIT -> STOP [label="q_stop: explicit STOP"];
SLEEP -> START [label="pending wake event"];
DECODE -> START [label="recoverable trap -> TVEC"];
DWAIT -> START [label="recoverable access fault -> TVEC"];
DECODE -> STOP [label="unrecoverable fault"];
}

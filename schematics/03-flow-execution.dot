digraph G {
graph [rankdir=LR,labelloc=t,fontname="DejaVu Sans",fontsize=16,pad=0.3];
node [shape=box,style="rounded,filled",fillcolor="#f1f5f9",color="#475569",fontname="DejaVu Sans",fontsize=11];
edge [fontname="DejaVu Sans",fontsize=9,color="#334155"];
label="MICA 2.0 | F memory operations with compact counted branches";
decode [label="DECODE: read old base/data\nF enabled; base != 0 and base != data\ncheck alignment and register IDs"];
request [label="DREQ / DWAIT\nd_req_valid/ready; d_rsp_valid/ready\naddress = old base"];
commit [label="COMMIT on successful response\nload destination + base update\nstore base update only"];
fault [label="Access fault: discard pending writes\nno base/destination update\nfailed store must have no side effect"];
loop [label="dbnz.s: 2-byte counter branch\ncounter -= 1; branch if nonzero\n-64..+62 bytes from PC+2"];
decode -> request [label="legal"];
request -> commit [label="d_rsp_error=0"];
request -> fault [label="d_rsp_error=1"];
commit -> loop [label="next instruction"];
loop -> decode [label="taken"];
}

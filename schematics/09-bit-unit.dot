digraph G {
graph [rankdir=LR,labelloc=t,fontname="DejaVu Sans",fontsize=16,pad=0.3];
node [shape=box,style="rounded,filled",fillcolor="#f1f5f9",color="#475569",fontname="DejaVu Sans",fontsize=11];
edge [fontname="DejaVu Sans",fontsize=9,color="#334155"];
label="MICA 2.0 | optional B execution through precise commit";
decode [label="Major 11, op[25:20]\ndst[19:16], a[15:12], b[11:8]\nreserved low bits zero"];
guard [label="BITOPS parameter / register guards\nunary b=0; valid opcode"];
rf [label="8 or 16 x XLEN register array\nx0 fixed zero"];
alu [label="CLZ / CTZ / POPCNT / REV8\nrotate / min / max / Boolean ops"];
pending [label="q_value1 / q_dst1 / q_w1\nCOMMIT or precise fault"];
decode -> guard [label="validate"];
rf -> alu [label="operands"];
guard -> alu [label="legal"];
alu -> pending [label="XLEN result"];
pending -> rf [label="successful retirement"];
}

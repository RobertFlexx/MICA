; Runs on the transactional SoC and reference emulator, MICA32 + T.
.arch mica32
    csrr x1,arch
    li8 x2,32
    bne x1,x2,failed
    csrr x4,features
    li32 x2,0x800
    li32 x1,0x12345678
    stw x1,[x2]
    ldw x3,[x2]
    bne x1,x3,failed
    li8 x1,21
    add x1,x1
    li8 x3,42
    bne x1,x3,failed
    li32 x1,handler
    csrw tvec,x1
    li8 x1,0
    csrw cmp_hi,x1
    csrr x1,timer_lo
    add3i x1,x1,1000
    csrw cmp_lo,x1
    li8 x1,2
    csrw ie,x1
    li8 x1,1
    csrw status,x1
    li8 x5,0
wait_tick:
    bz x5,wait_tick
    li32 x1,0xffff0010
    li8 x2,3
    stw x2,[x1]
    li32 x1,message
    call mica_puts
    li8 x1,42
    wfi
handler:
    addi sp,-16
    stw x1,[sp]
    li8 x1,-1
    csrw cmp_hi,x1
    ldw x1,[sp]
    addi sp,16
    addi x5,1
    eret
failed:
    li8 x1,-1
    wfi
.include "../stdlib/console32.mica"
message: .asciz "MICA 1.0 OK\n"

digraph sheet {
graph[rankdir=TB,bgcolor="white",fontname="DejaVu Sans",pad=0.35,nodesep=0.65,ranksep=0.9,splines=polyline,outputorder=edgesfirst,size="16.54,11.69",ratio=compress];
node[shape=box,style="rounded,filled,dashed",fillcolor="#edf3f8",color="#334e68",fontname="DejaVu Sans",fontsize=11,margin="0.16,0.13",penwidth=1.2];
edge[color="#174a70",fontname="DejaVu Sans Mono",fontsize=9,arrowsize=0.65,penwidth=1.2];
graph[labelloc=t,label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="19"><B>MICA 3.0 development | 17 / 20 | Complete implemented SoC integration</B></FONT></TD></TR><TR><TD ALIGN="LEFT">ISA 2.0 compatibility baseline | Enabled SoC interfaces | implemented RTL</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">RTL source set 5fbe88e7b5ecdbe5 | internal clock: clk_i rising edge; reset: rst_ni active low</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Instance interfaces are generated from elaborated mica_soc connections; all port widths and directions are recorded.<BR ALIGN="LEFT"/>CPU requests pass through real address decode and response selection in mica_soc.<BR ALIGN="LEFT"/>UART RX, CRC and watchdog are enabled here. Standalone SPI is not falsely attached to this SoC.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">Blue: data. Dashed gray: control/handshake. Red: fault. Repeated Nxx labels connect without a wire. Crossings do not join.</FONT></TD></TR></TABLE>>];
fabric[label="mica_soc parent nets and logic
Repeated labels are the same elaborated net.
Nxxx labels identify anonymous generated nets;
exact bit IDs and RTL names are in soc-connectivity.json.",fillcolor="#e3edf2"];
c0[label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD COLSPAN="2"><B>core</B><BR/>mica_core_txn</TD></TR><TR><TD><B>IN</B></TD><TD><B>OUT</B></TD></TR><TR><TD ALIGN="LEFT">d_req_ready[1] : dr</TD><TD ALIGN="LEFT">d_req_addr[32] : da</TD></TR><TR><TD ALIGN="LEFT">d_rsp_error[1] : dse</TD><TD ALIGN="LEFT">d_req_size[3] : size</TD></TR><TR><TD ALIGN="LEFT">d_rsp_rdata[32] : rd</TD><TD ALIGN="LEFT">d_req_valid[1] : dv</TD></TR><TR><TD ALIGN="LEFT">d_rsp_valid[1] : ds</TD><TD ALIGN="LEFT">d_req_wdata[32] : wd</TD></TR><TR><TD ALIGN="LEFT">i_req_ready[1] : ir</TD><TD ALIGN="LEFT">d_req_write[1] : dw</TD></TR><TR><TD ALIGN="LEFT">i_rsp_error[1] : se</TD><TD ALIGN="LEFT">d_req_wstrb[4] : strb</TD></TR><TR><TD ALIGN="LEFT">i_rsp_rdata[32] : insn</TD><TD ALIGN="LEFT">d_rsp_ready[1] : dsr</TD></TR><TR><TD ALIGN="LEFT">i_rsp_valid[1] : sv</TD><TD ALIGN="LEFT">fault_o[1] : fault_o</TD></TR><TR><TD ALIGN="LEFT">irq_i[1] : N001</TD><TD ALIGN="LEFT">halt_o[1] : halted_o</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">i_req_addr[32] : ia</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">i_req_valid[1] : iv</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">i_rsp_ready[1] : sr</TD></TR></TABLE>>,fontsize=10,style="rounded,filled"];
c1[label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD COLSPAN="2"><B>ram</B><BR/>mica_sram_txn</TD></TR><TR><TD><B>IN</B></TD><TD><B>OUT</B></TD></TR><TR><TD ALIGN="LEFT">d_req_addr[32] : da</TD><TD ALIGN="LEFT">d_req_ready[1] : ram_ready</TD></TR><TR><TD ALIGN="LEFT">d_req_size[3] : size</TD><TD ALIGN="LEFT">d_rsp_error[1] : ram_error</TD></TR><TR><TD ALIGN="LEFT">d_req_valid[1] : N002</TD><TD ALIGN="LEFT">d_rsp_rdata[32] : ram_data</TD></TR><TR><TD ALIGN="LEFT">d_req_wdata[32] : wd</TD><TD ALIGN="LEFT">d_rsp_valid[1] : ram_valid</TD></TR><TR><TD ALIGN="LEFT">d_req_write[1] : dw</TD><TD ALIGN="LEFT">i_req_ready[1] : ir</TD></TR><TR><TD ALIGN="LEFT">d_req_wstrb[4] : strb</TD><TD ALIGN="LEFT">i_rsp_error[1] : se</TD></TR><TR><TD ALIGN="LEFT">d_rsp_ready[1] : dsr</TD><TD ALIGN="LEFT">i_rsp_rdata[32] : insn</TD></TR><TR><TD ALIGN="LEFT">i_req_addr[32] : ia</TD><TD ALIGN="LEFT">i_rsp_valid[1] : sv</TD></TR><TR><TD ALIGN="LEFT">i_req_valid[1] : iv</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">i_rsp_ready[1] : sr</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>,fontsize=10,style="rounded,filled"];
c2[label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD COLSPAN="2"><B>uart</B><BR/>mica_uart_tx</TD></TR><TR><TD><B>IN</B></TD><TD><B>OUT</B></TD></TR><TR><TD ALIGN="LEFT">data_i[8] : uart_byte</TD><TD ALIGN="LEFT">busy_o[1] : uart_busy</TD></TR><TR><TD ALIGN="LEFT">send_i[1] : uart_send</TD><TD ALIGN="LEFT">uart_tx_o[1] : uart_tx_o</TD></TR></TABLE>>,fontsize=10,style="rounded,filled"];
c3[label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD COLSPAN="2"><B>receive.rx</B><BR/>mica_uart_rx</TD></TR><TR><TD><B>IN</B></TD><TD><B>OUT</B></TD></TR><TR><TD ALIGN="LEFT">uart_rx_i[1] : uart_rx_i</TD><TD ALIGN="LEFT">byte_o[8] : rx_byte</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">byte_valid_o[1] : rx_valid</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">framing_error_o[1] : rx_error</TD></TR></TABLE>>,fontsize=10,style="rounded,filled"];
c4[label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD COLSPAN="2"><B>receive.fifo</B><BR/>mica_sync_fifo</TD></TR><TR><TD><B>IN</B></TD><TD><B>OUT</B></TD></TR><TR><TD ALIGN="LEFT">pop_ready_i[1] : rx_pop</TD><TD ALIGN="LEFT">level_o[5] : rx_level</TD></TR><TR><TD ALIGN="LEFT">push_data_i[8] : rx_byte</TD><TD ALIGN="LEFT">pop_data_o[8] : rx_front</TD></TR><TR><TD ALIGN="LEFT">push_valid_i[1] : rx_valid</TD><TD ALIGN="LEFT">pop_valid_o[1] : rx_available</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">push_ready_o[1] : rx_ready</TD></TR></TABLE>>,fontsize=10,style="rounded,filled"];
c5[label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD COLSPAN="2"><B>checksum.bridge</B><BR/>mica_crc_mmio</TD></TR><TR><TD><B>IN</B></TD><TD><B>OUT</B></TD></TR><TR><TD ALIGN="LEFT">busy_i[1] : crc_busy</TD><TD ALIGN="LEFT">byte_o[8] : crc_byte</TD></TR><TR><TD ALIGN="LEFT">byte_ready_i[1] : crc_byte_ready</TD><TD ALIGN="LEFT">byte_valid_o[1] : crc_push</TD></TR><TR><TD ALIGN="LEFT">count_i[32] : crc_count</TD><TD ALIGN="LEFT">clear_o[1] : crc_clear</TD></TR><TR><TD ALIGN="LEFT">crc_i[32] : crc_result</TD><TD ALIGN="LEFT">req_ready[1] : crc_ready</TD></TR><TR><TD ALIGN="LEFT">req_addr[4] : N003</TD><TD ALIGN="LEFT">rsp_error[1] : crc_error</TD></TR><TR><TD ALIGN="LEFT">req_size[3] : size</TD><TD ALIGN="LEFT">rsp_rdata[32] : crc_data</TD></TR><TR><TD ALIGN="LEFT">req_valid[1] : N004</TD><TD ALIGN="LEFT">rsp_valid[1] : crc_valid</TD></TR><TR><TD ALIGN="LEFT">req_wdata[32] : unshifted</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">req_write[1] : dw</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">rsp_ready[1] : dsr</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>,fontsize=10,style="rounded,filled"];
c6[label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD COLSPAN="2"><B>checksum.engine</B><BR/>mica_crc32</TD></TR><TR><TD><B>IN</B></TD><TD><B>OUT</B></TD></TR><TR><TD ALIGN="LEFT">byte_i[8] : crc_byte</TD><TD ALIGN="LEFT">busy_o[1] : crc_busy</TD></TR><TR><TD ALIGN="LEFT">byte_valid_i[1] : crc_push</TD><TD ALIGN="LEFT">byte_ready_o[1] : crc_byte_ready</TD></TR><TR><TD ALIGN="LEFT">clear_i[1] : crc_clear</TD><TD ALIGN="LEFT">count_o[32] : crc_count</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">crc_o[32] : crc_result</TD></TR></TABLE>>,fontsize=10,style="rounded,filled"];
c7[label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD COLSPAN="2"><B>safety.watchdog</B><BR/>mica_watchdog</TD></TR><TR><TD><B>IN</B></TD><TD><B>OUT</B></TD></TR><TR><TD ALIGN="LEFT">clear_i[1] : safety.watchdog_clear</TD><TD ALIGN="LEFT">count_o[32] : watchdog_count</TD></TR><TR><TD ALIGN="LEFT">enable_i[1] : N005</TD><TD ALIGN="LEFT">early_o[1] : watchdog_early</TD></TR><TR><TD ALIGN="LEFT">kick_i[1] : safety.watchdog_kick</TD><TD ALIGN="LEFT">expired_o[1] : watchdog_expired</TD></TR><TR><TD ALIGN="LEFT">max_ticks_i[32] : watchdog_max</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">min_ticks_i[32] : watchdog_min</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>,fontsize=10,style="rounded,filled"];

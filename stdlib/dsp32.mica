; Scalar signed 16-bit dot product, MICA32 + M.
; x1=A, x2=B, x3=element count -> x1=sum modulo 2^32.
; x4 is scratch. Preserves x5, x6 and sp. Empty input reads no data.
mica_dot_s16:
    push x5
    push x6
    li8 x4,0
dot_s16_loop:
    bz x3,dot_s16_done
    ldh x5,[x1]
    ldh x6,[x2]
    mul x5,x6
    add x4,x5
    addi x1,2
    addi x2,2
    addi x3,-1
    b dot_s16_loop
dot_s16_done:
    mov x1,x4
    pop x6
    pop x5
    ret

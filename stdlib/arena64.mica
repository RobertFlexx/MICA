; 64-bit monotonic arena, 16-byte allocation granularity.
; Requires MICA64. Region base must be 16-byte aligned. Not thread-safe.
mica_arena_init:
    li32 x3, mica_arena_cursor
    stq x1, [x3]
    add x2, x1
    li32 x3, mica_arena_limit
    stq x2, [x3]
    ret

mica_arena_alloc:
    push x5
    li32 x2, mica_arena_cursor
    ldq x4, [x2]
    li32 x3, mica_arena_limit
    ldq x5, [x3]
    mov x3, x1
    addi x1, 15
    sltu3 x3, x1, x3
    bnz x3, arena64_failed
    li64 x3, 0xfffffffffffffff0
    and3 x1, x1, x3
    add3 x3, x4, x1
    sltu3 x1, x3, x4
    bnz x1, arena64_failed
    sltu3 x1, x5, x3
    bnz x1, arena64_failed
    stq x3, [x2]
    mov x1, x4
    pop x5
    ret
arena64_failed:
    li8 x1, 0
    pop x5
    ret

.align 8
mica_arena_cursor: .quad 0
mica_arena_limit: .quad 0
